# Build output
/target
**/target

# devenv
.devenv
.direnv

# Locally installed cargo binaries
.bin

# Editor and OS noise
.DS_Store
*.swp

# npm
node_modules
*.tsbuildinfo

# Coverage output
lcov.info
coverage/

# Locally generated reports
report.json
score.txt

# Binaries staged into platform packages by scripts/stage-binaries.mjs.
# They are built by the release workflow and must never be committed: a checked-in
# binary would ship whatever architecture the last developer built on.
packages/monostyle__cli_*/bin/monostyle
packages/monostyle__cli_*/bin/monostyle.exe

# mdbook build output
docs/book/

# mdt cache
.mdt/cache/

# devenv-generated pre-commit config (nix store symlink)
.pre-commit-config.yaml
